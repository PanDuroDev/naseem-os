{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 6,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["custom/menubar", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/notification", "tray", "network", "pulseaudio", "battery"],
  "custom/menubar": {
    "format": "\uf06c",
    "tooltip": false,
    "on-click": "nwg-drawer -wm hyprland -c 6 -nocats -is 56 -mt 60 -mb 60 -ml 60 -mr 60"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "\uf111",
      "default": "\uf10c",
      "urgent": "\uf111"
    },
    "persistent-workspaces": {
      "*": 5
    }
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 64,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/notification": {
    "format": "\uf0f3",
    "tooltip": false,
    "exec": "echo bell",
    "interval": 30,
    "on-click": "naseem-control",
    "on-click-right": "makoctl dismiss --all"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\uf0ac",
    "format-disconnected": "\uf127",
    "tooltip-format": "{essid} {signalStrength}%",
    "on-click": "nmtui"
  },
  "pulseaudio": {
    "format": "\uf028  {volume}%",
    "format-muted": "\uf026",
    "on-click": "naseem-volume mute",
    "on-scroll-up": "naseem-volume up",
    "on-scroll-down": "naseem-volume down"
  },
  "battery": {
    "format": "\uf240  {capacity}%",
    "format-charging": "\uf0e7  {capacity}%",
    "format-plugged": "\uf0e7  {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  }
}
