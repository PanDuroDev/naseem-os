#!/bin/bash
# Naseem OS - volume keys with an on-screen notification.
set -uo pipefail

case "${1:-}" in
    up)   wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *)    exit 1 ;;
esac

state=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
pct=$(echo "$state" | awk '{printf "%d", $2 * 100}')
if [[ "$state" == *MUTED* ]]; then
    notify-send -a Naseem -h string:x-canonical-private-synchronous:volume \
        -h int:value:0 "Volume" "Muted"
else
    notify-send -a Naseem -h string:x-canonical-private-synchronous:volume \
        -h int:value:"$pct" "Volume" "${pct}%"
fi
